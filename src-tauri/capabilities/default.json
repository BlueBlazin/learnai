{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: core IPC (including channels), the opener plugin, and the Learn AI commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "allow-list-tracks",
    "allow-list-problems",
    "allow-get-problem",
    "allow-read-solution",
    "allow-write-solution",
    "allow-reset-solution",
    "allow-start-run",
    "allow-cancel-run",
    "allow-list-submissions",
    "allow-get-submission",
    "allow-unlock-editorial",
    "allow-get-reference",
    "allow-env-status",
    "allow-env-install",
    "allow-get-stats",
    "allow-list-catalog-issues",
    "allow-list-areas",
    "allow-list-skills",
    "allow-skills-earned-by",
    "allow-get-problem-asset",
    "allow-list-assets",
    "allow-fetch-assets",
    "allow-cancel-asset-fetch",
    "allow-remove-asset",
    "allow-list-ssh-hosts",
    "allow-list-targets",
    "allow-add-target",
    "allow-remove-target",
    "allow-check-target",
    "allow-list-reviews",
    "allow-start-review",
    "allow-read-review-solution",
    "allow-write-review-solution",
    "allow-resolve-review",
    "allow-get-settings",
    "allow-set-reviews-enabled",
    "allow-set-editor-intelligence",
    "allow-editor-status",
    "allow-editor-start",
    "allow-editor-send",
    "allow-editor-stop",
    "allow-editor-install",
    "allow-editor-docs"
  ]
}
